{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soul.md/schemas/observation.schema.json",
  "title": "Soul Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "timestamp",
    "source",
    "type",
    "scope",
    "summary",
    "importance",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "client"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "client": { "type": "string", "minLength": 1 },
        "model": { "type": "string" }
      }
    },
    "type": {
      "const": "observation"
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "importance": {
      "enum": ["low", "medium", "high"]
    },
    "confidence": {
      "enum": ["low", "medium", "high"]
    },
    "evidence": {
      "type": "string",
      "maxLength": 4000
    },
    "supersedes": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "suggested_updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "field", "value"],
        "properties": {
          "target": { "type": "string" },
          "field": { "type": "string" },
          "value": {}
        }
      }
    }
  }
}